---
import '../styles/global.css';

import Page from "../layouts/Page.astro";
import ProjectDetails from "../components/ProjectDetails.astro";
import GalleryExpandedImage from "../components/GalleryExpandedImage.astro";

import projects from '../data/projects.json';
import type { Project } from "../data/types";
---

<Page title="All Projects - Leonardo Corona-Garza">
    <div class="flex-centered margin-top">
        <h1>All Projects & Roles</h1>
        <h3><a href="/" class="local-link">‹ Leonardo Corona-Garza</a></h3>
    </div>
    <ProjectDetails project={projects[0]} />
    {projects.slice(1).map((project: Project) => (
        <hr>
        <ProjectDetails project={project} />
    ))}
    <GalleryExpandedImage />
</Page>
