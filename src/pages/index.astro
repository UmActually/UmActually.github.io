---
import '../styles/global.css';

import Page from '../layouts/Page.astro';
import NameHeader from "../components/NameHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import JobProjectCard from "../components/JobProjectCard.astro";
import ShowMoreButton from "../components/ShowMoreButton.astro";
import CertificationCard from "../components/CertificationCard.astro";

import allProjects from '../data/projects.json';
import { certifications } from "../data/certifications.ts";

import tecLogo from '../assets/tec-black.png';
import appleLogo from '../assets/apple-black.svg';
import swiftLogo from '../assets/swift-black.png';
import type { Project } from "../data/types";

const jobProjects: Project[] = allProjects.filter((p) => p.job);
const projects: Project[] = allProjects.filter((p) => !p.job);
---

<Page title="Leonardo Corona-Garza">
	<NameHeader/>

	<div class="container">
		<h2>About Me</h2>
		<p class="secondary margin-top">
			Computer engineer graduated from <strong><img src={tecLogo.src} alt="<Tec de Monterrey logo>" style="translate: 0 2px;"> Tec de Monterrey</strong> in 2025.
			Specialized in application development for <strong><img src={appleLogo.src} alt="<Apple logo>" style="translate: 0 1px;"> Apple platforms</strong> with the <strong><img src={swiftLogo.src} alt="<Swift logo>" style="translate: 0 1px;"> Swift language</strong>.<br><br>
			<strong>6 months of professional experience</strong> developing and maintaining <strong>large-scale iOS apps</strong> with UIKit, Auto Layout, and the VIPER design pattern. <strong>5 years of project-based experience</strong> with <strong>SwiftUI</strong>, modern concurrency, the MVVM pattern, and frameworks like CoreAnimation, MultipeerConnectivity and Accelerate. Published <strong>two App Store apps</strong> for iOS, iPadOS and tvOS.<br><br>
			Led small <strong>agile development teams</strong> for full-stack web freelance projects. Solid understanding of operating systems, networks, web cybersecurity and software cost analysis.
			Self-taught background in music, design and audiovisual editing as well.
		</p>
	</div>

	<hr>
	<p class="container secondary margin-top">
		Below is a summary of my recent projects and roles. Or see all &nbsp;<span class="monospaced"><strong><a href="/projects" class="local-link">in detail ›</a></strong></span>
	</p>
	<hr>

	<div class="container margin-top">
		<h2>Work Experience</h2>
		<p class="secondary margin-top">Click on an item for details.<br>Experience gained is listed as <span class="skills-list tech">Technologies</span> and <span class="skills-list">Skills</span>.</p>
	</div>

	{jobProjects.map((project) => (
		<JobProjectCard project={project} />
	))}

	<div class="container margin-top">
		<h2>Recent Projects</h2>
		<p class="secondary margin-top">Click on an item for details.<br>Experience gained is listed as <span class="skills-list tech">Technologies</span> and <span class="skills-list">Skills</span>.</p>
	</div>

	<div id="projects">
		{projects.map((project, index) => (
			<ProjectCard project={project} index={index} />
		))}
	</div>

	<ShowMoreButton/>

	<hr>

	<div class="container">
		<h2>Licenses & Certifications</h2>
	</div>

	<div id="certifications">
		{certifications.map((cert) => (
			<CertificationCard cert={cert} />
		))}
	</div>

	<hr>
</Page>

<style>
	hr {
		margin: 2rem 0;
	}

	.small {
		font-size: small;
	}

	.secondary strong {
		color: var(--fg-primary);
	}

	span.skills-list {
		font-family: "JetBrains Mono", sans-serif !important;
		font-size: small;
		color: var(--bg-white);
		padding: 0.25rem 0.5rem;
		background-color: var(--accent-orange);
	}

	span.skills-list.tech {
		background-color: var(--accent-blue);
	}

</style>